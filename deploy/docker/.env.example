# Copy to /opt/lorevista/.env on the server.
# This file contains deployment settings only. Application secrets live in
# deploy/docker/runtime/backend.env.

# Private Docker Registry image prefix, not a Git repository URL.
# Example images:
#   ghcr.io/dream619/manwen-studio/backend:v1.0.0
#   ghcr.io/dream619/manwen-studio/web:v1.0.0
#   ghcr.io/dream619/manwen-studio/updater:v1.0.0
REGISTRY_IMAGE_PREFIX=ghcr.io/dream619/manwen-studio
# Use a fixed release tag for manual, controlled updates.
APP_VERSION=v1.0.0

WEB_BIND_ADDR=127.0.0.1
WEB_PORT=8080
LOREVISTA_APP_DIR=/opt/lorevista
LOREVISTA_DATA_DIR=/opt/lorevista/data
DOCKER_CONFIG_DIR=/root/.docker

POSTGRES_DB=manga_novel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

DATABASE_URL=postgresql://postgres:change-this-postgres-password@postgres:5432/manga_novel
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
SYSTEM_INSTALLED=false
RUN_STARTUP_MIGRATIONS=false

# First-run installer restart behavior.
# Docker deployments normally leave these empty: backend exits itself and
# Docker Compose restarts it through restart: unless-stopped.
INSTALL_RESTART_COMMAND=
INSTALL_PM2_PROCESS_NAME=
INSTALL_ALLOW_DEV_RESTART=false
INSTALL_RESTART_DELAY=1.2

UPDATER_URL=http://updater:8090
# Set a long random value and keep it identical for backend and updater.
UPDATER_TOKEN=change-this-updater-token
# Optional update manifest for the admin "check update" button.
# The manifest should publish the latest stable Docker tag, for example v1.2.3.
UPDATE_MANIFEST_URL=https://example.com/lorevista/update-manifest.json
# Optional bearer token if the manifest endpoint is private.
UPDATE_MANIFEST_TOKEN=
