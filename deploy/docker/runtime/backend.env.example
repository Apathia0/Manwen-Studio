# Copy to deploy/docker/runtime/backend.env on the server.
# Do not commit the real backend.env file.

APP_ENV=production
# 至少 32 个随机字符；上线后不得直接更换，否则已有密文需要先执行重加密迁移。
AI_CREDENTIAL_SECRET=change-this-with-openssl-rand-hex-32

DEEPSEEK_API_KEY=
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://newapi.aifusion6.cn/v1
VIDEO_API_KEY=
VIDEO_API_BASE_URL=https://newapi.aifusion6.cn/v1
VIDEO_MODEL=veo3.1-fast

SYSTEM_INSTALLED=false
REDIS_ENABLED=true
RUN_STARTUP_MIGRATIONS=false
# 仅本地开发可开启；生产环境必须保持 false，避免用户自行确认模拟支付。
ALLOW_MOCK_PAYMENTS=false

CORS_ORIGINS=https://your-domain.example
PASSWORD_HASH_ITERATIONS=600000
SESSION_TTL_DAYS=30
# 启用用户自定义 URL 时必须填写可信域名，多个域名用逗号分隔。
USER_UPSTREAM_HOST_ALLOWLIST=
MAX_UPLOAD_BYTES=10485760
MAX_REMOTE_IMAGE_BYTES=52428800
MAX_REMOTE_VIDEO_BYTES=2147483648
MAX_REMOTE_MEDIA_BYTES=2147483648
API_TOKEN=
# 可选：漫画 ZIP 短时下载签名密钥；留空时由数据库自动生成并供所有后端副本共享。
STORYCANVAS_DOWNLOAD_SECRET=
