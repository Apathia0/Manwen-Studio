# ─────────────────────────────────────────────────────────────
#  Secrets & environment
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
# 编辑器/脚本生成的 .env 备份，极易误带真实密钥
*.env.bak*
*.env.env.bak*
*.env.bak.*
.env.local
.env.production
.env.development

# 凭据文件
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.json
credentials.json
service-account*.json

# 授权服务真实配置（模板 *.example 保留）
auth/config/database.php
auth/config/contact.php
auth/install.lock

# ─────────────────────────────────────────────────────────────
#  Nested repo —— auth/ 是独立仓库，作为子目录提交会变成失效的 gitlink
# ─────────────────────────────────────────────────────────────
/auth/

# ─────────────────────────────────────────────────────────────
