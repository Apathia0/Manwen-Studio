# 运行环境；生产部署必须设置为 production。
APP_ENV=development

# DeepSeek API
# Optional. Users can enter this in the web UI instead.
# Backend env value is only used as a fallback when the frontend key is empty.
DEEPSEEK_API_KEY=

# Image2 API
# Optional. Users can enter this in the web UI instead.
# Backend env value is only used as a fallback when the frontend key is empty.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://newapi.aifusion6.cn/v1

# Video API (xbyapp.com, same token as Image2)
# Optional. Falls back to IMAGE_API_KEY if empty.
VIDEO_API_KEY=
# Video API (New API standard)
VIDEO_API_BASE_URL=https://newapi.aifusion6.cn/v1
VIDEO_MODEL=veo3.1-fast

# ComfyUI local video generation (optional)
# Set VIDEO_PROVIDER=comfyui to use local ComfyUI instead of cloud API
# VIDEO_PROVIDER=comfyui
# ComfyUI server URL (default http://127.0.0.1:8188)
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# Workflow template filenames (in backend/workflows/ directory)
# COMFYUI_T2V_WORKFLOW=comfyui_t2v.json
# COMFYUI_I2V_WORKFLOW=comfyui_i2v.json

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manga_novel

# First-run installer
# Set to true after the web installer completes. Existing deployments with users
# are also treated as installed even if this is empty.
SYSTEM_INSTALLED=false
# Optional restart integration for the install wizard.
# Docker deployments can leave this empty; the backend exits and Docker Compose
# restarts it via restart: unless-stopped. Linux/PM2 deployments should set
# INSTALL_PM2_PROCESS_NAME to the PM2 process name, or provide an explicit
# command such as:
# INSTALL_RESTART_COMMAND=pm2 reload canvas-backend --update-env
INSTALL_PM2_PROCESS_NAME=
INSTALL_RESTART_COMMAND=
# Linux only: do not enable unless this is a local development process without
# PM2/systemd. Production should use the command or PM2 options above.
INSTALL_ALLOW_DEV_RESTART=false

# Redis
# The installer writes this after a successful PING check. Current runtime only
# stores the configuration; task/cache/session logic does not require Redis yet.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
# Optional. If set, frontend must set matching VITE_API_TOKEN.
API_TOKEN=
# 漫画 ZIP 短时下载签名密钥，生产环境必须使用至少 32 字节随机值并在所有后端副本间保持一致。
STORYCANVAS_DOWNLOAD_SECRET=

