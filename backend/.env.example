# DeepSeek API
# Optional. Users can enter this in the web UI instead.
# Backend env value is only used as a fallback when the frontend key is empty.
DEEPSEEK_API_KEY=

# Image2 API
# Optional. Users can enter this in the web UI instead.
# Backend env value is only used as a fallback when the frontend key is empty.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.xbyjs.top/v1

# Video API (xbyapp.com, same token as Image2)
# Optional. Falls back to IMAGE_API_KEY if empty.
VIDEO_API_KEY=
# Video API (New API 标准)
VIDEO_API_BASE_URL=https://api.xbyjs.top/v1
VIDEO_MODEL=veo3.1-fast

# ComfyUI 本地视频生成（可选）
# 设置 VIDEO_PROVIDER=comfyui 后，视频生成将走本地 ComfyUI 而非云 API
# VIDEO_PROVIDER=comfyui
# ComfyUI 服务地址（默认 http://127.0.0.1:8188）
# COMZYUI_BASE_URL=http://127.0.0.1:8188
# 工作流模板文件名（放在 backend/workflows/ 目录下）
# COMZYUI_T2V_WORKFLOW=comfyui_t2v.json
# COMZYUI_I2V_WORKFLOW=comfyui_i2v.json

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manga_novel

# Server
HOST=127.0.0.1
PORT=8000
# Hot reload on file changes (default: true). Set to false to disable.
RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
# Optional. If set, frontend must set matching VITE_API_TOKEN.
API_TOKEN=
