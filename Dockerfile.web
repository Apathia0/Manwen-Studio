FROM node:22-alpine AS web-build

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22-alpine AS h5-build

WORKDIR /app/storycanvas-mobile
COPY storycanvas-mobile/package*.json ./
RUN npm ci
COPY storycanvas-mobile/ ./
RUN npm run build:h5

FROM nginx:1.27-alpine AS runtime

COPY deploy/docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/frontend/dist /usr/share/nginx/html
COPY --from=h5-build /app/storycanvas-mobile/dist/build/h5 /usr/share/nginx/html/h5

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null && \
        wget -qO- http://127.0.0.1/h5/ >/dev/null || exit 1
